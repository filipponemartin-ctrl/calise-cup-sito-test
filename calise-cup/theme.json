{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1100px",
			"wideSize": "1100px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "sabbia",
					"name": "Sabbia chiara (sfondo)",
					"color": "#FFF8EC"
				},
				{
					"slug": "sabbia-scura",
					"name": "Sabbia",
					"color": "#F4E4C4"
				},
				{
					"slug": "bianco",
					"name": "Bianco",
					"color": "#FFFFFF"
				},
				{
					"slug": "inchiostro",
					"name": "Inchiostro (testo)",
					"color": "#13213F"
				},
				{
					"slug": "grigio",
					"name": "Grigio (testo secondario)",
					"color": "#4E5B73"
				},
				{
					"slug": "linea",
					"name": "Linea",
					"color": "#E9DCC2"
				},
				{
					"slug": "blu-calise",
					"name": "Blu Calise (logo)",
					"color": "#1F4BC8"
				},
				{
					"slug": "azzurro",
					"name": "Azzurro (logo)",
					"color": "#0CB8F2"
				},
				{
					"slug": "azzurro-chiaro",
					"name": "Azzurro chiaro",
					"color": "#E2F5FD"
				},
				{
					"slug": "rosso",
					"name": "Rosso Calise (logo)",
					"color": "#E2262D"
				},
				{
					"slug": "sole",
					"name": "Sole",
					"color": "#FFC53D"
				},
				{
					"slug": "sole-chiaro",
					"name": "Sole chiaro",
					"color": "#FFF0C9"
				},
				{
					"slug": "notte",
					"name": "Blu notte",
					"color": "#0D1D4A"
				}
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "titoli",
					"name": "Titoli (Lora)",
					"fontFamily": "\"Lora\", Georgia, \"Times New Roman\", serif"
				},
				{
					"slug": "testo",
					"name": "Testo (Nunito Sans)",
					"fontFamily": "\"Nunito Sans\", \"Segoe UI\", system-ui, sans-serif"
				},
				{
					"slug": "a-mano",
					"name": "A mano (Caveat)",
					"fontFamily": "\"Caveat\", \"Segoe Print\", cursive"
				}
			],
			"fontSizes": [
				{
					"slug": "piccolo",
					"name": "Piccolo",
					"size": "0.9rem"
				},
				{
					"slug": "normale",
					"name": "Normale",
					"size": "1.0625rem"
				},
				{
					"slug": "medio",
					"name": "Medio",
					"size": "1.25rem"
				},
				{
					"slug": "grande",
					"name": "Grande",
					"size": "2.3rem",
					"fluid": {
						"min": "1.7rem",
						"max": "2.3rem"
					}
				},
				{
					"slug": "enorme",
					"name": "Enorme",
					"size": "3.9rem",
					"fluid": {
						"min": "2.4rem",
						"max": "3.9rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--sabbia)",
			"text": "var(--wp--preset--color--inchiostro)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--testo)",
			"fontSize": "var(--wp--preset--font-size--normale)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"padding": {
				"left": "1rem",
				"right": "1rem",
				"top": "0",
				"bottom": "0"
			},
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--titoli)",
					"fontWeight": "600",
					"lineHeight": "1.15"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--enorme)",
					"fontWeight": "700"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--grande)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.25rem"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.1rem"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--blu-calise)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--blu-calise)",
					"text": "var(--wp--preset--color--bianco)"
				},
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontWeight": "700",
					"fontSize": "1rem"
				},
				"spacing": {
					"padding": {
						"top": "0.7rem",
						"bottom": "0.7rem",
						"left": "1.3rem",
						"right": "1.3rem"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--grigio)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--titoli)",
					"fontSize": "1.35rem",
					"fontWeight": "700",
					"lineHeight": "1"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--inchiostro)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/site-tagline": {
				"typography": {
					"fontSize": "0.78rem"
				},
				"color": {
					"text": "var(--wp--preset--color--grigio)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "0.98rem",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--inchiostro)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--grande)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Testata",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Piè di pagina",
			"area": "footer"
		}
	],
	"customTemplates": []
}
